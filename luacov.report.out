      100     tc_string = p.tc_string,

      100     special_features_opt_in = p.specialFeaturesOptIn,
      100     purpose = {
      100       consents = p.purposeConsents,
      100       legitimate_interests = p.purposeLegitimateInterests,
      100     },
      100     vendor = {
      100       consents = p.vendorConsents,
      100       legitimate_interests = p.vendorLegitimateInterests,
      100     },
              -- publisher and other segments will be added in Phase 3/4
            }

      100   return res
          end

        2 return M

