        4 describe("Plumbing", function()
        4   describe("Bit bridge", function()
        4     it("performs band correctly", function()
        2       assert.are.equal(0, bit.band(0xF0, 0x0F))
              end)

        4     it("performs bor correctly", function()
        2       assert.are.equal(0xFF, bit.bor(0xF0, 0x0F))
              end)

        4     it("performs lshift correctly", function()
        2       assert.are.equal(16, bit.lshift(1, 4))
              end)

        4     it("performs rshift correctly", function()
        2       assert.are.equal(1, bit.rshift(16, 4))
              end)
            end)

        4   describe("Base64url", function()
        4     it("decodes simple strings", function()
        2       local decoded = base64.decode_url("AB")
        2       assert.are.equal(string.char(0), decoded)
              end)

        4     it("decodes TCF header snippet", function()
        2       local decoded = base64.decode_url("COw")
        2       assert.are.equal(0x08, string.byte(decoded, 1))
        2       assert.are.equal(0xEC, string.byte(decoded, 2))
              end)
            end)

        4   describe("BitStream", function()
        4     it("reads integers correctly", function()
        2       local decoded = base64.decode_url("COw")
        2       local bs = BitStream.new(decoded)
        2       assert.are.equal(2, bs:read_int(6))
        2       assert.are.equal(14, bs:read_int(6))
        2       assert.are.equal(12, bs:read_int(4))
              end)

        4     it("reads booleans correctly", function()
        2       local bs = BitStream.new(string.char(0x80)) -- 10000000
        2       assert.is_true(bs:read_bool())
        2       assert.is_false(bs:read_bool())
