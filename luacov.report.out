        3 local base64 = require("gdpr.iab.tcfv2.base64")
        3 local BitStream = require("gdpr.iab.tcfv2.bitstream")
        3 local DisclosedVendors = require("gdpr.iab.tcfv2.disclosed_vendors")
        3 local AllowedVendors = require("gdpr.iab.tcfv2.allowed_vendors")
        3 local PublisherTC = require("gdpr.iab.tcfv2.publisher_tc")

        3 local Router = {}

        3 local DECODERS = {
        3   [1] = DisclosedVendors,
        3   [2] = AllowedVendors,
        3   [3] = PublisherTC,
          }

        3 function Router.decode_segments(segments, options)
       57   local results = {}
            -- Skip the first segment (Core)
      114   for i = 2, #segments do
       57     local b64 = segments[i]
       57     local data, err = base64.decode_url(b64)
       57     if data then
       57       local bs = BitStream.new(data)
       57       local segment_type = bs:peek_int(3)
       57       if segment_type and DECODERS[segment_type] then
       57         local decoder = DECODERS[segment_type]
       57         local segment_obj, d_err = decoder.new(data, options)
       57         if segment_obj then
       57           results[segment_type] = segment_obj
********0         elseif options.strict then
********0           return nil,
********0             "failed to decode segment " .. i .. ": " .. tostring(d_err)
                  end
********0       elseif options.strict then
********0         return nil, "unknown segment type: " .. tostring(segment_type)
                end
********0     elseif options.strict then
********0       return nil, "invalid base64 in segment " .. i .. ": " .. tostring(err)
              end
            end
       57   return results
          end

        3 return Router

