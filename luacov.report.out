            -- get value
        6   _, _, v = key:find(".-%=(.+)")

            -- get key(s), remove spaces
        6   key = split(key, "=")[1]:gsub(" ", "")

            -- get short key & extended key
        6   _, _, k = key:find("^%-([^-][^%s,]*)")
        6   _, _, ek = key:find("%-%-(.+)$")

        6   if v == "" then
********0     v = nil
            end

        6   return k,ek,v
          end

********0 return disect

