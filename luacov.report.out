          -- exported module table
********0 local state = {}

          ------------------------------------------------------
          -- Reverts to a (specific) snapshot.
          -- @param self (optional) the snapshot to revert to. If not provided, it will revert to the last snapshot.
          state.revert = function(self)
********0   if not self then
