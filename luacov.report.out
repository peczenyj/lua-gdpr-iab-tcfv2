        5 local base64 = require("gdpr.iab.tcfv2.base64")
        5 local Core = require("gdpr.iab.tcfv2.core")
        3 local Router = require("gdpr.iab.tcfv2.router")

        3 local M = {}

          local function split(input, sep)
      222   local t = {}
      281   for str in string.gmatch(input, "([^" .. sep .. "]+)") do
      114     table.insert(t, str)
            end
       59   return t
          end

       58 function M.new(tc_string, options)
       57   if not tc_string or tc_string == "" then
********0     return nil, "missing gdpr consent string"
            end

      112   options = options or {}
       57   local segments = split(tc_string, "%.")

            -- Decode Core segment
      112   local core_b64 = segments[1]
      112   local core_data, err = base64.decode_url(core_b64)
       57   if not core_data then
********0     return nil, "invalid base64 in core segment: " .. tostring(err)
            end

            -- Initialize Core object
      112   local core = Core.new(core_data, options)
       57   core.tc_string = tc_string

            -- Basic validation
       57   if options.strict then
********0     if core.version ~= 2 then
********0       return nil, "consent string is not tcf version 2"
              end
********0     if core.vendorListVersion == 0 then
********0       return nil, "invalid vendor list version"
              end
            end

            -- Route other segments
      167   local other_segments, r_err = Router.decode_segments(segments, options)
      112   if not other_segments then
       55     return nil, r_err
            end

            -- We use a proxy metatable to expose Core fields directly on the Parser object.
      164   local parser = setmetatable({
       57     _core = core,
     1177     _segments = segments,
       57     _other = other_segments,
       57   }, {
              __index = function(tbl, key)
     1174       if key == "tc_string" then
     1170         return tbl._core.tc_string
                end
     2244       if key == "warnings" then
********0         return tbl._core.warnings
                end

                -- Check other segments
     1124       if tbl._other[1] and tbl._other[1][key] ~= nil then
********0         return tbl._other[1][key]
                end
     1124       if tbl._other[2] and tbl._other[2][key] ~= nil then
********0         return tbl._other[2][key]
                end
     1124       if tbl._other[3] and tbl._other[3][key] ~= nil then
        4         return tbl._other[3][key]
                end

                -- Delegate to Core
     1120       local val = tbl._core[key]
     1120       if val ~= nil then
     1175         return val
                end

       55       if key == "to_table" then
        2         return function(p)
********0           local res = p._core:to_table()
        2           for _, seg in pairs(p._other) do
********0             for k, v in pairs(seg) do
********0               res[k] = v
                      end
                    end
********0           return res
                  end
                end

********0       if key == "is_v22_plus" then
********0         return tbl._core.policyVersion >= 4
                end

********0       if key == "is_v23" then
********0         return tbl._core.policyVersion >= 5
                end

********0       return M[key]
              end,
            })

       57   return parser
          end

        3 return M

