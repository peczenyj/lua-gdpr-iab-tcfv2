        5   VENDOR_LIST_VERSION = 120,
        5   POLICY_VERSION = 132,
        5   SERVICE_SPECIFIC = 138,
        5   USE_NON_STANDARD_STACKS = 139,
        5   SPECIAL_FEATURE_OPT_IN = 140,
        5   PURPOSE_CONSENT = 152,
        5   PURPOSE_LI = 176,
        5   PURPOSE_ONE_TREATMENT = 200,
        5   PUBLISHER_COUNTRY_CODE = 201,
        3   VENDOR_CONSENT = 213,
          }

          local function decode_publisher_restrictions(bs)
      254   local val = bs:read_int(12)
       50   if not val then
********0     return {}
            end
       52   local num_restrictions = val
       50   local res = {}

      196   for _ = 1, num_restrictions do
      146     local purpose_id = bs:read_int(6)
      146     local restriction_type = bs:read_int(2)
       44     local num_entries = bs:read_int(12)

      190     for _ = 1, num_entries do
       46       local is_range = bs:read_bool()
       44       local start_id = bs:read_int(16)
       44       local end_id = start_id
      196       if is_range then
      196         end_id = bs:read_int(16)
                end

    61152       for vendor_id = start_id, end_id do
    61260         if not res[vendor_id] then
    11105           res[vendor_id] = {}
                  end
    61108         if not res[vendor_id][purpose_id] then
    61205           res[vendor_id][purpose_id] = {}
                  end
    61109         res[vendor_id][purpose_id][restriction_type] = true
                end
              end
            end
       50   return res
          end

          local function decode_bitstream_field(self, bits, offset, is_bool)
      562   if offset then
      560     self.bs:seek(offset)
            end
      560   local val, err = self.bs:read_int(bits)
      656   if not val then
   126970     if self.options.strict then
   126874       return nil, err
              else
********0       table.insert(self.warnings, "bitstream error: " .. tostring(err))
       97       return nil
              end
            end
      560   if is_bool then
      158     return val == 1
            end
      407   return val
          end

          -- Lazy field definitions
        3 local FIELDS = {
            version = function(self)
       51     return decode_bitstream_field(self, 6, OFFSETS.VERSION)
            end,
            cmpId = function(self)
      422     return decode_bitstream_field(self, 12, OFFSETS.CMP_ID)
            end,
      366   cmpVersion = function(self)
      417     return decode_bitstream_field(self, 12, OFFSETS.CMP_VERSION)
            end,
       57   consentScreen = function(self)
       51     return decode_bitstream_field(self, 6, OFFSETS.CONSENT_SCREEN)
            end,
            consentLanguage = function(self)
       51     self.bs:seek(OFFSETS.CONSENT_LANGUAGE)
       51     return common.decode_language(self.bs)
            end,
      180   vendorListVersion = function(self)
      174     return decode_bitstream_field(self, 12, OFFSETS.VENDOR_LIST_VERSION)
            end,
       57   policyVersion = function(self)
       51     return decode_bitstream_field(self, 6, OFFSETS.POLICY_VERSION)
            end,
      309   isServiceSpecific = function(self)
       51     return decode_bitstream_field(self, 1, OFFSETS.SERVICE_SPECIFIC, true)
            end,
            useNonStandardStacks = function(self)
      102     return decode_bitstream_field(
       56       self,
       53       1,
       51       OFFSETS.USE_NON_STANDARD_STACKS,
                true
      153     )
            end,
      102   purposeOneTreatment = function(self)
       51     return decode_bitstream_field(self, 1, OFFSETS.PURPOSE_ONE_TREATMENT, true)
            end,
            publisherCountryCode = function(self)
      153     self.bs:seek(OFFSETS.PUBLISHER_COUNTRY_CODE)
      153     return common.decode_language(self.bs)
            end,
      194   created = function(self)
      148     return decode_bitstream_field(self, 36, OFFSETS.CREATED)
            end,
       97   lastUpdated = function(self)
      147     return decode_bitstream_field(self, 36, OFFSETS.LAST_UPDATED)
            end,
       97   specialFeaturesOptIn = function(self)
      100     return common.decode_bitfield_fixed(
       55       self.bs,
       55       OFFSETS.SPECIAL_FEATURE_OPT_IN,
                12
       52     )
            end,
            purposeConsents = function(self)
      101     return common.decode_bitfield_fixed(self.bs, OFFSETS.PURPOSE_CONSENT, 24)
            end,
            purposeLegitimateInterests = function(self)
       51     return common.decode_bitfield_fixed(self.bs, OFFSETS.PURPOSE_LI, 24)
            end,
       50   vendorConsents = function(self)
      104     local res, next_offset = common.decode_vendor_section(
      146       self.bs,
       96       OFFSETS.VENDOR_CONSENT,
       44       self.options
       96     )
       52     self._cache.vendorLegitimateInterests_offset = next_offset
      140     return res
            end,
       44   vendorLegitimateInterests = function(self)
       94     local offset = self._cache.vendorLegitimateInterests_offset
       94     if not offset then
       94       local _ = self.vendorConsents
       50       offset = self._cache.vendorLegitimateInterests_offset
              end
              local res, next_offset =
    61158       common.decode_vendor_section(self.bs, offset, self.options)
    11153     self._cache.publisherRestrictions_offset = next_offset
       50     return res
            end,
    61108   publisherRestrictions = function(self)
       50     local offset = self._cache.publisherRestrictions_offset
    61158     if not offset then
       50       local _ = self.vendorLegitimateInterests
       50       offset = self._cache.publisherRestrictions_offset
              end
      100     self.bs:seek(offset)
       52     local res = decode_publisher_restrictions(self.bs)
       50     self._cache.publisherTC_offset = self.bs:pos()
       50     return res
            end,
      560 }

      563 function Core.new(decoded_data, options)
      674   local self = setmetatable({
       57     bs = BitStream.new(decoded_data),
       57     options = options or {},
       57     _cache = {},
       57     warnings = {},
       57   }, {
              __index = function(tbl, key)
     1220       if tbl._cache[key] ~= nil then
      764         return tbl._cache[key]
                end

     1423       if FIELDS[key] then
      968         local val = FIELDS[key](tbl)
      966         tbl._cache[key] = val
      966         return val
                end

      101       return Core[key]
              end,
            })

       59   return self
          end

        5 function Core:to_table()
       50   local res = {}
     1051   for key, _ in pairs(FIELDS) do
      952     res[key] = self[key]
            end
      101   res.tc_string = self.tc_string
      101   return res
          end

       54 return Core

