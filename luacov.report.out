     1350    for piece in pathname:gmatch("(.-)/") do
      990       if piece == ".." then
********0          local prev = pieces[#pieces]
********0          if not prev or prev == ".." then
********0             table.insert(pieces, "..")
********0          elseif prev ~= "" then
********0             table.remove(pieces)
                   end
      990       elseif piece ~= "." then
